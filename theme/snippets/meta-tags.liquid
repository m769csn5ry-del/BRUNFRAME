{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_image = settings.share_image
  if template.name == 'product' and product.featured_image
    assign og_image = product.featured_image
  endif
-%}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
{%- if page_description %}<meta property="og:description" content="{{ page_description | escape }}">{% endif -%}
{%- if og_image %}
<meta property="og:image" content="https:{{ og_image | image_url: width: 1200, height: 630, crop: 'center' }}">
<meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
