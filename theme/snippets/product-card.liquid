{%- comment -%} Carte produit. Params: product, loading ('lazy' par défaut / 'eager') {%- endcomment -%}
{%- assign loading = loading | default: 'lazy' -%}
{%- assign second = product.media[1] -%}
<article style="position:relative">
  <a class="bg-card" href="{{ product.url }}" data-handle="{{ product.handle }}">
    <div class="bg-card__img">
      {%- unless product.available %}<span class="bg-card__tag">{{ 'products.sold_out' | t }}</span>{% endunless -%}
      {%- if product.featured_media -%}
        {{ product.featured_media | image_url: width: 900 | image_tag: loading: loading, widths: '360, 540, 720, 900', sizes: '(min-width: 1280px) 25vw, (min-width: 900px) 33vw, 50vw', alt: product.featured_media.alt | default: product.title }}
      {%- endif -%}
      {%- if second and second.media_type == 'image' -%}
        {{ second | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 1280px) 25vw, (min-width: 900px) 33vw, 50vw', alt: '' }}
      {%- endif -%}
    </div>
    <div class="bg-card__meta">
      {%- if product.type != blank %}<span class="bg-card__f">{{ product.type | escape }}</span>{% endif -%}
      <span class="bg-card__t">{{ product.title | escape }}</span>
      <span class="bg-card__p">{{ product.price | money }}</span>
      {%- if product.variants.size > 1 %}<span class="bg-card__v">{{ product.variants.size }} {{ 'products.variants' | t }}</span>{% endif -%}
    </div>
  </a>
  {%- if product.available and product.has_only_default_variant -%}
    <button class="bg-card__add" type="button" data-quick-add="{{ product.selected_or_first_available_variant.id }}" data-title="{{ product.title | escape }}" aria-label="{{ 'products.add' | t }} — {{ product.title | escape }}">+</button>
  {%- endif -%}
</article>
