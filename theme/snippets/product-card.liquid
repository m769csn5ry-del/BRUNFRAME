{%- comment -%}
  Carte produit. Paramètres : product (objet produit), delay (décalage d'apparition 0–0.5), eager (bool), sizes.
  Tout reste lisible sans survol : nom, prix, état. Les photos restent entières (aucun recadrage) ; le survol montre la 2e photo.
{%- endcomment -%}
{%- liquid
  assign img = product.featured_media.preview_image | default: product.featured_image
  assign img2 = product.media[1].preview_image
  assign sizes = sizes | default: '(min-width: 1100px) 25vw, (min-width: 750px) 33vw, 50vw'
  assign price_min = product.price_min | money
-%}
<article class="card" data-anim="rise"{% if delay %} data-anim-delay="{{ delay }}"{% endif %}>
  <a class="card__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    {%- if img != blank -%}
      <span class="ph-bg" style="background-image:url('{{ img | image_url: width: 40 }}')" aria-hidden="true"></span>
      <img src="{{ img | image_url: width: 640 }}" srcset="{{ img | image_url: width: 360 }} 360w, {{ img | image_url: width: 640 }} 640w, {{ img | image_url: width: 960 }} 960w" sizes="{{ sizes }}" alt="{{ img.alt | default: product.title | escape }}" width="{{ img.width }}" height="{{ img.height }}" loading="{% if eager %}eager{% else %}lazy{% endif %}">
      {%- if img2 != blank -%}<img src="{{ img2 | image_url: width: 640 }}" alt="" width="{{ img2.width }}" height="{{ img2.height }}" loading="lazy">{%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag }}
    {%- endif -%}
  </a>
  {%- unless product.available -%}<span class="card__badge">{{ 'products.sold_out' | t }}</span>{%- endunless -%}
  <button class="fav" type="button" data-fav="{{ product.handle }}" aria-pressed="false" aria-label="{{ 'products.fav_toggle' | t }} : {{ product.title | escape }}">{% render 'icon', name: 'heart' %}</button>
  <div class="card__meta">
    <a class="card__title" href="{{ product.url }}">{{ product.title }}</a>
    <span class="card__price">{% if product.price_varies %}{{ 'products.from_price' | t: price: price_min }}{% else %}{{ product.price | money }}{% endif %}</span>
  </div>
</article>
