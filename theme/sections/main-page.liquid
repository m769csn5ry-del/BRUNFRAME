<div class="wrap page-head">
  {%- if section.settings.label != blank -%}<p class="label label--rule" data-anim="fade">{{ section.settings.label }}</p>{%- endif -%}
  <h1 class="h1" data-anim="title">{{ page.title }}</h1>
  {%- if section.settings.intro != blank -%}<p class="lead" data-anim="title" data-anim-delay="0.1" style="margin-top:20px">{{ section.settings.intro }}</p>{%- endif -%}
</div>
{%- if page.content != blank -%}
  <div class="wrap" style="padding-bottom:clamp(48px,6vw,96px)"><div class="prose" data-anim="fade">{{ page.content }}</div></div>
{%- endif -%}

{% schema %}
{
  "name": "Page",
  "settings": [
    { "type": "text", "id": "label", "label": "Sur-titre" },
    { "type": "textarea", "id": "intro", "label": "Introduction" }
  ]
}
{% endschema %}
