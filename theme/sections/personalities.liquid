{%- comment -%}
  Portraits 9:16 en galerie manuelle ; clic = photo entière. Les noms viennent uniquement de la liste fournie par la maison :
  tant qu'un nom n'est pas renseigné, rien n'est affiché sous la photo (aucun nom supposé).
{%- endcomment -%}
<section class="section people" data-people aria-label="{{ section.settings.heading | escape }}">
  <div class="wrap sec-head">
    <div>
      {%- if section.settings.label != blank -%}<p class="label label--rule" data-anim="fade">{{ section.settings.label }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="h1" data-anim="title">{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
    {%- if section.settings.layout == 'gallery' -%}
    <div class="arrows">
      <button class="arrow" type="button" data-people-nav="-1" aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'prev' %}</button>
      <button class="arrow" type="button" data-people-nav="1" aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'next' %}</button>
    </div>
    {%- endif -%}
  </div>
  <div class="{% if section.settings.layout == 'grid' %}wrap people-grid{% else %}people__track{% endif %}" tabindex="0" aria-label="{{ section.settings.heading | escape }}">
    {%- for block in section.blocks -%}
      {%- liquid
        assign name = block.settings.name | strip
        if block.settings.image != blank
          assign small = block.settings.image | image_url: width: 540
          assign full = block.settings.image | image_url: width: 1440
        else
          assign small = block.settings.asset | append: '-540.webp' | asset_url
          assign full = block.settings.asset | append: '-1080.webp' | asset_url
        endif
      -%}
      <figure class="person" data-anim="rise" data-anim-delay="0.{{ forloop.index0 | modulo: 4 }}" {{ block.shopify_attributes }}>
        <button class="person__btn" type="button" data-full="{{ full }}" aria-label="{{ section.settings.open_label }}{% if name != blank %} : {{ name | escape }}{% endif %}">
          <img src="{{ small }}" alt="{% if name != blank %}{{ name | escape }}{% else %}{{ section.settings.alt_default | escape }}{% endif %}" width="540" height="960" loading="lazy">
        </button>
        <figcaption class="person__name">{{ name }}</figcaption>
      </figure>
    {%- endfor -%}
  </div>
  {%- if section.settings.page_link != blank -%}
    <div class="wrap" style="margin-top:28px"><a class="link-arrow" href="{{ section.settings.page_link }}">{{ section.settings.page_label }} {% render 'icon', name: 'arrow' %}</a></div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Personnalités",
  "max_blocks": 30,
  "settings": [
    { "type": "select", "id": "layout", "label": "Présentation", "options": [ { "value": "gallery", "label": "Galerie manuelle (accueil)" }, { "value": "grid", "label": "Grille (page complète)" } ], "default": "gallery" },
    { "type": "text", "id": "label", "label": "Sur-titre", "default": "Personnalités" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Breslev Gang, à leur manière" },
    { "type": "text", "id": "open_label", "label": "Libellé d'agrandissement (accessibilité)", "default": "Agrandir le portrait" },
    { "type": "text", "id": "alt_default", "label": "Texte alternatif sans nom", "default": "Portrait de la galerie Breslev Gang" },
    { "type": "text", "id": "page_label", "label": "Lien vers la page complète", "default": "Toute la galerie" },
    { "type": "text", "id": "page_link", "label": "Adresse de la page complète", "default": "/pages/personnalites" }
  ],
  "blocks": [
    {
      "type": "person",
      "name": "Portrait",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo 9:16" },
        { "type": "text", "id": "asset", "label": "Ou photo fournie avec le thème", "info": "Ex. portrait-9799 (fichiers portrait-XXXX-540.webp et -1080.webp)." },
        { "type": "text", "id": "name", "label": "Nom affiché", "info": "À renseigner depuis la liste validée par la maison. Laisser vide tant que le nom n'est pas confirmé." }
      ]
    }
  ],
  "presets": [ { "name": "Personnalités" } ]
}
{% endschema %}
