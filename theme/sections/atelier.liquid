{%- comment -%} Atelier : vidéos réelles importées dans Shopify (Contenu > Fichiers), muettes, en boucle, lues seulement à l'écran (bg-atelier.js). Sans vidéo, la section ne s'affiche pas. {%- endcomment -%}
{%- assign has_video = false -%}
{%- for b in section.blocks -%}{%- if b.settings.video != blank -%}{%- assign has_video = true -%}{%- endif -%}{%- endfor -%}
{%- if has_video -%}
<script src="{{ 'bg-atelier.js' | asset_url }}" defer></script>
<section class="bg-section bg-atelier" data-atelier hidden><div class="bg-wrap bg-atelier__layout">
  <div class="bg-atelier__head"><div><p class="bg-kicker">{{ section.settings.kicker | escape }}</p><h2 class="bg-display"><span class="bg-l"><span>{{ section.settings.title_1 | escape }}</span></span><span class="bg-l" style="--i:1"><span><em>{{ section.settings.title_2 | escape }}</em></span></span></h2></div>
    {%- if section.settings.text != blank -%}<p class="bg-dim" style="max-width:34ch">{{ section.settings.text | escape }}</p>{%- endif -%}</div>
  <div class="bg-atelier__row" data-atelier-row>
    {%- for b in section.blocks -%}{%- if b.settings.video != blank -%}
      <figure class="bg-atelier__clip" {{ b.shopify_attributes }}>
        {{ b.settings.video | video_tag: muted: true, loop: true, playsinline: true, preload: 'metadata', image_size: '720x', aria-label: b.settings.label }}
        {%- if b.settings.label != blank -%}<figcaption>{{ b.settings.label | escape }}</figcaption>{%- endif -%}
      </figure>
    {%- endif -%}{%- endfor -%}
  </div>
  <button class="bg-btn bg-btn--ghost bg-btn--sm" type="button" data-atelier-toggle aria-pressed="false">Mettre en pause</button>
</div></section>
<script>document.addEventListener('DOMContentLoaded', function () { window.BG && BG.initAtelier && BG.initAtelier(); });</script>
{%- endif -%}
{% schema %}
{ "name": "Atelier (vidéos)", "max_blocks": 6, "settings": [
  { "type": "text", "id": "kicker", "label": "Sur-titre", "default": "L’atelier" },
  { "type": "text", "id": "title_1", "label": "Titre", "default": "Du geste." },
  { "type": "text", "id": "title_2", "label": "Titre (italique)", "default": "Au bijou." },
  { "type": "text", "id": "text", "label": "Texte", "default": "Les mains, les outils, les bijoux : les gestes filmés à l’atelier." } ],
  "blocks": [ { "type": "clip", "name": "Vidéo", "settings": [ { "type": "video", "id": "video", "label": "Vidéo (format vertical conseillé)" }, { "type": "text", "id": "label", "label": "Légende courte (geste réellement visible)" } ] } ],
  "presets": [ { "name": "Atelier (vidéos)" } ] }
{% endschema %}
