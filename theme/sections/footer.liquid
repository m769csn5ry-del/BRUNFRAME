<footer class="bg-footer">
  <div class="bg-wrap">
    <div class="bg-footer__brand">
      {%- if settings.logo != blank -%}{{ settings.logo | image_url: width: 640 | image_tag: loading: 'lazy', alt: shop.name }}{%- else -%}<p class="bg-display" style="font-size:40px">{{ shop.name }}</p>{%- endif -%}
      {%- if section.settings.tagline != blank -%}<q>{{ section.settings.tagline | escape }}</q>{%- endif -%}
    </div>
    <div class="bg-footer__cols">
      <div><h3>{{ linklists[section.settings.menu_shop].title | default: 'Boutique' }}</h3><ul>{% for l in linklists[section.settings.menu_shop].links %}<li><a href="{{ l.url }}">{{ l.title | escape }}</a></li>{% endfor %}</ul></div>
      <div><h3>{{ linklists[section.settings.menu_help].title | default: 'Aide' }}</h3><ul>{% for l in linklists[section.settings.menu_help].links %}<li><a href="{{ l.url }}">{{ l.title | escape }}</a></li>{% endfor %}</ul></div>
      <div><h3>Informations</h3><ul>
        <li><a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">Confidentialité</a></li>
        <li><a href="{{ shop.terms_of_service.url | default: '/policies/terms-of-service' }}">Conditions</a></li>
        <li><a href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}">Retours & remboursement</a></li>
        <li><a href="{{ shop.shipping_policy.url | default: '/policies/shipping-policy' }}">Livraison</a></li>
        <li><a href="/policies/legal-notice">Mentions légales</a></li>
      </ul></div>
      <div><h3>Paiement</h3><ul class="bg-pay">{%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}</ul></div>
    </div>
    <div class="bg-legal"><span>© {{ 'now' | date: '%Y' }} {{ shop.name }}</span><span>{{ section.settings.legal_line | escape }}</span></div>
  </div>
</footer>
{% schema %}
{ "name": "Pied de page", "settings": [
  { "type": "text", "id": "tagline", "label": "Signature de marque", "default": "Not Just Necklace it’s a Protection" },
  { "type": "link_list", "id": "menu_shop", "label": "Menu boutique", "default": "footer" },
  { "type": "link_list", "id": "menu_help", "label": "Menu aide" },
  { "type": "text", "id": "legal_line", "label": "Mentions société", "default": "[Raison sociale / SIRET / adresse — à compléter, non inventés]" } ] }
{% endschema %}
