{%- assign total = section.blocks.size -%}
<section class="section showcase" data-showcase aria-roledescription="carrousel" aria-label="{{ section.settings.heading | escape }}">
  <div class="wrap sec-head">
    <div>
      <p class="label label--rule" data-anim="fade">{{ section.settings.label }}</p>
      <h2 class="h1" data-anim="title">{{ section.settings.heading }}</h2>
    </div>
  </div>
  <div class="showcase__viewport">
    <div class="showcase__track">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign list = block.settings.products
          if list == blank or list.size == 0
            assign list = c.products
          endif
          assign title = block.settings.title | default: c.title
          assign link = block.settings.link | default: c.url
        -%}
        <div class="slide{% if forloop.first %} is-active{% endif %}" id="slide-{{ block.id }}" role="tabpanel" aria-label="{{ title | escape }}" {{ block.shopify_attributes }}>
          <div class="slide__copy">
            <p class="label label--rule">{{ forloop.index | prepend: '0' | slice: -2, 2 }} / {{ total | prepend: '0' | slice: -2, 2 }}</p>
            <h3 class="h1">{{ title }}</h3>
            {%- if block.settings.text != blank -%}<p class="lead">{{ block.settings.text }}</p>{%- endif -%}
            {%- if c != blank -%}<p class="slide__count">{{ 'collections.results' | t: count: c.products_count }}</p>{%- endif -%}
            {%- if link != blank -%}<a class="btn btn--line" href="{{ link }}">{%- if block.settings.link_label != blank -%}{{ block.settings.link_label }}{%- else -%}{{ 'general.view_all' | t }}{%- endif -%}</a>{%- endif -%}
          </div>
          <div class="compo">
            {%- for p in list limit: 4 -%}
              {%- assign im = p.featured_media.preview_image | default: p.featured_image -%}
              <a class="compo__item" href="{{ p.url }}" aria-label="{{ p.title | escape }}">
                {%- if im != blank -%}<span class="ph-bg" style="background-image:url('{{ im | image_url: width: 40 }}')" aria-hidden="true"></span><img src="{{ im | image_url: width: 900 }}" srcset="{{ im | image_url: width: 480 }} 480w, {{ im | image_url: width: 900 }} 900w" sizes="(min-width: 900px) 30vw, 60vw" alt="{{ p.title | escape }}" width="{{ im.width }}" height="{{ im.height }}" loading="lazy">{%- endif -%}
              </a>
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
  <div class="wrap showcase__nav">
    <div class="tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <button type="button" role="tab" data-tab aria-controls="slide-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">{{ block.settings.title | default: c.title }}</button>
      {%- endfor -%}
    </div>
    <div class="arrows">
      <button class="arrow" type="button" data-show-nav="-1" aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'prev' %}</button>
      <button class="arrow" type="button" data-show-nav="1" aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'next' %}</button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Univers",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "label", "label": "Sur-titre", "default": "Les collections" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Six univers" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Titre affiché (sinon : nom de la collection)" },
        { "type": "textarea", "id": "text", "label": "Texte court" },
        { "type": "product_list", "id": "products", "label": "Produits de la composition (jusqu'à 4)", "limit": 4, "info": "Vide : les 4 premiers produits de la collection. Moins de 4 produits : la composition montre le nombre réel." },
        { "type": "url", "id": "link", "label": "Ou lien libre (produit, recherche)" },
        { "type": "text", "id": "link_label", "label": "Libellé du bouton" }
      ]
    }
  ],
  "presets": [ { "name": "Univers" } ]
}
{% endschema %}
