{%- comment -%}
  Scène d'accueil + tringle. Chaque bloc = un produit Shopify (sélecteur, jamais d'ID codé en dur).
  Rendu de la pièce : détourage PNG (bloc) > photo produit officielle en cadre chromé > plaque neutre.
  Coloris : variantes réelles du produit (option 1), avec leur image.
{%- endcomment -%}
{%- assign shown = 0 -%}
<section class="bg-stage" data-stage aria-label="{{ section.settings.kicker | escape }}">
  <div class="bg-stage__word" data-parallax aria-hidden="true">{{ shop.name }}</div>
  <div class="bg-wrap bg-stage__copy">
    <p class="bg-kicker bg-fade" style="--i:0">{{ section.settings.kicker | escape }}</p>
    <h1 class="bg-display"><span class="bg-l" style="--i:1"><span>{{ section.settings.title_1 | escape }}</span></span><span class="bg-l" style="--i:2"><span><em class="bg-chrome-text">{{ section.settings.title_2 | escape }}</em></span></span></h1>
    <p class="bg-stage__sub bg-fade" style="--i:3">{{ section.settings.sub | escape }}</p>
    <div class="bg-stage__cta bg-fade" style="--i:4">
      <a class="bg-btn" href="{{ section.settings.cta_url | default: routes.collections_url }}">{{ section.settings.cta | escape }}</a>
      {%- if section.settings.link_label != blank -%}<a class="bg-arrow" href="{{ section.settings.link_url }}">{{ section.settings.link_label | escape }}</a>{%- endif -%}
    </div>
  </div>
  <div class="bg-rail" data-bg-rail tabindex="0" role="group" aria-label="{{ 'rail.label' | t }}">
    <canvas aria-hidden="true"></canvas>
    <p class="bg-rail__hint"><i></i>{{ 'rail.hint' | t }}</p>
    <script type="application/json" data-rail-items>
      [{%- for block in section.blocks -%}{%- assign p = block.settings.product -%}{%- if p != blank -%}{%- unless shown == 0 -%},{%- endunless -%}{%- assign shown = shown | plus: 1 -%}
      {"handle":{{ p.handle | json }},"title":{{ p.title | json }},"priceLabel":{{ p.price | money | json }},"url":{{ p.url | json }},
       "variantId":{{ p.selected_or_first_available_variant.id | json }},"focusY":{{ block.settings.focus_y | divided_by: 100.0 }},
       "photo":{% if p.featured_media %}{{ p.featured_media | image_url: width: 520 | json }}{% else %}null{% endif %},
       "photos":[{%- for m in p.media limit: 3 -%}{{ m | image_url: width: 200 | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
       "cutout":{% if block.settings.cutout %}{{ block.settings.cutout | image_url: width: 520 | json }}{% else %}null{% endif %},
       "colors":[{%- unless p.has_only_default_variant -%}{%- for v in p.variants -%}{"name":{{ v.option1 | json }},"title":{{ p.title | json }},"priceLabel":{{ v.price | money | json }},"url":{{ v.url | json }},"variantId":{{ v.id }},"photo":{% if v.featured_media %}{{ v.featured_media | image_url: width: 520 | json }}{% else %}null{% endif %}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}{%- endunless -%}]}
      {%- endif -%}{%- endfor -%}]
    </script>
    <div class="bg-rail__panel" data-rail-panel hidden>
      <div class="bg-rail__nav"><button type="button" data-p-prev aria-label="{{ 'rail.prev' | t }}">‹</button><button type="button" data-p-next aria-label="{{ 'rail.next' | t }}">›</button><button type="button" data-p-close aria-label="{{ 'general.close' | t }}">✕</button></div>
      <h3 data-p-title></h3>
      <span class="bg-rail__price" data-p-price></span>
      <div class="bg-rail__photos" data-p-photos></div>
      <div class="bg-rail__chips" data-p-colors></div>
      <div class="bg-rail__actions"><a class="bg-btn bg-btn--ghost" data-p-link href="#">{{ 'products.view' | t }}</a><button class="bg-btn" type="button" data-p-add>{{ 'products.add_short' | t }}</button></div>
      <p class="bg-sr" aria-live="polite" data-p-live></p>
    </div>
  </div>
  <ul class="bg-sr">{%- for block in section.blocks -%}{%- if block.settings.product != blank -%}<li><a href="{{ block.settings.product.url }}">{{ block.settings.product.title | escape }} — {{ block.settings.product.price | money }}</a></li>{%- endif -%}{%- endfor -%}</ul>
</section>
{% schema %}
{
  "name": "Hero tringle",
  "max_blocks": 9,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Sur-titre", "default": "Maison parisienne · Colliers & Peteks" },
    { "type": "text", "id": "title_1", "label": "Titre ligne 1", "default": "Plus qu’un collier." },
    { "type": "text", "id": "title_2", "label": "Titre ligne 2 (italique chromé)", "default": "Une protection." },
    { "type": "text", "id": "sub", "label": "Texte", "default": "Faites glisser la tringle, approchez chaque pièce et choisissez la vôtre." },
    { "type": "text", "id": "cta", "label": "Bouton principal", "default": "Découvrir les colliers" },
    { "type": "url", "id": "cta_url", "label": "Lien du bouton" },
    { "type": "text", "id": "link_label", "label": "Lien secondaire", "default": "Best-sellers" },
    { "type": "url", "id": "link_url", "label": "URL du lien secondaire" }
  ],
  "blocks": [
    { "type": "necklace", "name": "Collier", "settings": [
      { "type": "product", "id": "product", "label": "Produit" },
      { "type": "image_picker", "id": "cutout", "label": "Détourage PNG transparent (optionnel, prioritaire sur la photo)" },
      { "type": "range", "id": "focus_y", "label": "Cadrage vertical de la photo", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 64 }
    ] }
  ],
  "presets": [ { "name": "Hero tringle" } ]
}
{% endschema %}
