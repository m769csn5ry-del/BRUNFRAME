{%- comment -%} Galerie orbitale de l'accueil (bg-orbit.js / bg-orbit.css). Chaque bloc = un collier réel + son fond.
  Prix, disponibilité, variante et URL sont lus dans Shopify ; aucun texte technique n'est inventé. {%- endcomment -%}
{{ 'bg-orbit.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bg-orbit.js' | asset_url }}" defer></script>
<section class="bg-orbit" data-orbit aria-roledescription="carrousel" aria-label="{{ section.settings.label | escape }}" tabindex="-1">
  <script type="application/json" data-orbit-items>[
    {%- for block in section.blocks -%}
      {%- assign p = block.settings.product -%}
      {%- if p != blank -%}
        {%- assign v = p.selected_or_first_available_variant -%}
        {%- assign img = block.settings.cutout | default: p.featured_media -%}
        {%- unless forloop.first %},{% endunless -%}
        {
          "handle": {{ p.handle | json }}, "title": {{ p.title | json }},
          "kicker": {{ p.type | default: section.settings.kicker_fallback | json }},
          "priceLabel": {{ p.price | money | json }}, "url": {{ p.url | json }},
          "variantId": {{ v.id | json }}, "available": {{ p.available | json }},
          "photo": {{ img | image_url: width: 900 | json }},
          "tone": [{{ block.settings.c1 | json }}, {{ block.settings.c2 | json }}, {{ block.settings.c3 | json }}],
          "heads": ["", {{ block.settings.head_2 | json }}, {% if p.available %}{{ 'Disponible' | json }}{% else %}{{ 'Épuisée' | json }}{% endif %}],
          "facts": [{{ block.settings.fact_1 | json }}, {{ block.settings.fact_2 | json }}, {{ p.price | money | json }}]
        }
      {%- endif -%}
    {%- endfor -%}
  ]</script>
  <div class="bg-orbit__pin" data-orbit-pin>
    <div class="bg-orbit__bg bg-orbit__studio" aria-hidden="true"></div><div class="bg-orbit__bg bg-orbit__color" aria-hidden="true"></div><div class="bg-orbit__bg bg-orbit__beam" aria-hidden="true"></div>
    <div class="bg-orbit__lamp" aria-hidden="true"></div>
    <div class="bg-orbit__top" data-orbit-gallery><p class="bg-kicker">{{ section.settings.kicker | escape }}</p><h1 class="bg-display">{{ section.settings.title_1 | escape }} <em class="bg-chrome-text">{{ section.settings.title_2 | escape }}</em></h1></div>
    <p class="bg-orbit__word" data-orbit-word aria-hidden="true">{{ section.settings.word | escape }}</p>
    <div class="bg-orbit__stage" data-orbit-stage role="group" aria-label="Glissez pour parcourir les colliers ; flèches gauche et droite au clavier"></div>
    <div class="bg-orbit__label" data-orbit-gallery data-orbit-label aria-hidden="true"></div>
    <button class="bg-btn bg-btn--ghost bg-btn--sm bg-orbit__enter" type="button" data-orbit-gallery data-orbit-enter>{{ section.settings.enter | escape }}</button>
    <div class="bg-orbit__ctrl" data-orbit-gallery><button type="button" data-orbit-prev aria-label="Collier précédent">‹</button><div class="bg-orbit__bar" data-orbit-bar aria-hidden="true"></div><button type="button" data-orbit-next aria-label="Collier suivant">›</button></div>
    <div class="bg-orbit__chapter" data-orbit-chapter="1"><p class="bg-kicker" data-o-kicker></p><h2 data-o-title></h2><p data-o-fact></p>
      <div class="bg-stage__cta"><button class="bg-btn" type="button" data-o-add>Ajouter au panier</button><a class="bg-btn bg-btn--ghost" data-o-link href="#">Voir la pièce</a></div></div>
    <div class="bg-orbit__chapter" data-orbit-chapter="2"><p class="bg-kicker">{{ section.settings.chapter_2 | escape }}</p><h3 data-o-head></h3><p data-o-fact></p></div>
    <div class="bg-orbit__chapter" data-orbit-chapter="3"><p class="bg-kicker" data-o-price></p><h3 data-o-head></h3><a class="bg-arrow" data-o-link href="#">Fiche produit</a></div>
    <div class="bg-orbit__aside" data-orbit-aside><button type="button" data-orbit-prev aria-label="Collier précédent">↑</button><span aria-hidden="true">Changer</span><button type="button" data-orbit-next aria-label="Collier suivant">↓</button></div>
    <p class="bg-orbit__faqt" data-orbit-faq aria-hidden="true">{{ section.settings.faq_title | escape | newline_to_br }}</p>
    <p class="bg-sr" aria-live="polite" data-orbit-live></p>
  </div>
  <ul class="bg-sr">
    {%- for block in section.blocks -%}{%- assign p = block.settings.product -%}{%- if p != blank -%}<li><a href="{{ p.url }}">{{ p.title | escape }} — {{ p.price | money }}</a></li>{%- endif -%}{%- endfor -%}
  </ul>
</section>
{%- if section.settings.show_faq -%}
<section class="bg-orbit-after" aria-labelledby="faq-{{ section.id }}"><div class="bg-wrap">
  <h2 class="bg-sr" id="faq-{{ section.id }}">{{ section.settings.faq_title | strip_newlines | escape }}</h2>
  {%- if section.settings.faq_page != blank -%}<div class="bg-faq bg-rte">{{ section.settings.faq_page.content }}</div>{%- endif -%}
  <div class="bg-lineup" data-orbit-lineup><p class="bg-kicker">{{ section.settings.lineup_kicker | escape }}</p><h2>{{ section.settings.lineup_title | escape }}</h2><div class="bg-lineup__row">
    {%- for block in section.blocks -%}{%- assign p = block.settings.product -%}{%- if p != blank -%}
      <a class="bg-lineup__item" href="{{ p.url }}" style="--k:{{ forloop.index0 }};--c1:{{ block.settings.c1 }}">{{ block.settings.cutout | default: p.featured_media | image_url: width: 600 | image_tag: loading: 'lazy', alt: '' }}<i></i><span>{{ p.title | escape }}</span></a>
    {%- endif -%}{%- endfor -%}
  </div>{%- if section.settings.cta_url != blank -%}<a class="bg-btn" href="{{ section.settings.cta_url }}">{{ section.settings.cta | escape }}</a>{%- endif -%}</div>
</div></section>
{%- endif -%}
{% schema %}
{
  "name": "Galerie orbitale",
  "max_blocks": 9,
  "settings": [
    { "type": "text", "id": "label", "label": "Nom accessible de la galerie", "default": "Les colliers Breslev Gang" },
    { "type": "text", "id": "kicker", "label": "Sur-titre", "default": "Maison parisienne · Colliers & Peteks" },
    { "type": "text", "id": "title_1", "label": "Titre", "default": "Plus qu’un collier." },
    { "type": "text", "id": "title_2", "label": "Titre (italique chromé)", "default": "Une protection." },
    { "type": "text", "id": "enter", "label": "Bouton d'entrée dans la pièce", "default": "Découvrir la pièce" },
    { "type": "text", "id": "kicker_fallback", "label": "Sur-titre du récit si le type produit est vide", "default": "Breslev Gang" },
    { "type": "text", "id": "chapter_2", "label": "Sur-titre du 2e chapitre", "default": "Famille" },
    { "type": "text", "id": "word", "label": "Grande typographie", "default": "It’s a protection" },
    { "type": "textarea", "id": "faq_title", "label": "Grand titre FAQ", "default": "Foire aux\nquestions" },
    { "type": "checkbox", "id": "show_faq", "label": "Afficher FAQ et retour de la ligne", "default": true },
    { "type": "page", "id": "faq_page", "label": "Page FAQ (contenu validé)" },
    { "type": "text", "id": "lineup_kicker", "label": "Sur-titre de la ligne", "default": "La ligne complète" },
    { "type": "text", "id": "lineup_title", "label": "Titre de la ligne", "default": "Choisissez la vôtre" },
    { "type": "text", "id": "cta", "label": "Bouton final", "default": "Tous les colliers" },
    { "type": "url", "id": "cta_url", "label": "Lien du bouton final" }
  ],
  "blocks": [
    { "type": "necklace", "name": "Collier", "settings": [
      { "type": "product", "id": "product", "label": "Produit" },
      { "type": "image_picker", "id": "cutout", "label": "Détourage PNG transparent (optionnel, prioritaire sur la photo)" },
      { "type": "color", "id": "c1", "label": "Fond : lumière", "default": "#c9d3dc" },
      { "type": "color", "id": "c2", "label": "Fond : teinte", "default": "#5f6c78" },
      { "type": "color", "id": "c3", "label": "Fond : bord", "default": "#0d1114" },
      { "type": "text", "id": "head_2", "label": "Titre du 2e chapitre (vérifié)" },
      { "type": "textarea", "id": "fact_1", "label": "Texte du 1er chapitre (vérifié)" },
      { "type": "textarea", "id": "fact_2", "label": "Texte du 2e chapitre (vérifié)" }
    ] }
  ],
  "presets": [ { "name": "Galerie orbitale" } ]
}
{% endschema %}
