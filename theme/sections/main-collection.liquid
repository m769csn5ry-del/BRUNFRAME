<div class="bg-wrap">
  <div class="bg-coll-head"><p class="bg-kicker">Collection</p><h1 class="bg-display">{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div class="bg-dim" style="max-width:60ch;margin-top:14px">{{ collection.description }}</div>{% endif %}</div>
  <form class="bg-bar" method="get" id="bg-filters" data-filters>
    <div class="bg-filters">
      {%- for f in collection.filters -%}
        {%- if f.type == 'list' -%}
          {%- for v in f.values -%}<label class="bg-chip" style="cursor:pointer"><input type="checkbox" class="bg-sr" name="{{ v.param_name }}" value="{{ v.value }}" {% if v.active %}checked{% endif %} {% if v.count == 0 and v.active == false %}disabled{% endif %} onchange="this.form.submit()"><span aria-pressed="{{ v.active }}">{{ f.label | escape }} : {{ v.label | escape }} ({{ v.count }})</span></label>{%- endfor -%}
        {%- elsif f.type == 'price_range' -%}
          <label class="bg-chip">Prix max <input type="number" name="{{ f.max_value.param_name }}" value="{{ f.max_value.value | divided_by: 100 }}" min="0" style="width:70px;background:none;border:0;color:inherit" onchange="this.form.submit()"></label>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <label class="bg-sr" for="sort">Trier</label>
    <select class="bg-select" id="sort" name="sort_by" onchange="this.form.submit()">
      {%- for o in collection.sort_options -%}<option value="{{ o.value }}" {% if o.value == collection.sort_by %}selected{% endif %}>{{ o.name | escape }}</option>{%- endfor -%}
    </select>
    <noscript><button class="bg-btn" type="submit">Appliquer</button></noscript>
  </form>
  {%- paginate collection.products by 24 -%}
    {%- if collection.products.size == 0 -%}<p class="bg-empty">Aucun produit ne correspond à ces filtres. <a href="{{ collection.url }}">Réinitialiser</a></p>
    {%- else -%}<div class="bg-grid">{%- for product in collection.products -%}{%- if forloop.index < 5 -%}{% render 'product-card', product: product, loading: 'eager' %}{%- else -%}{% render 'product-card', product: product %}{%- endif -%}{%- endfor -%}</div>{%- endif -%}
    {%- if paginate.pages > 1 -%}<nav class="bg-bar" style="margin-top:40px" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
  {%- endpaginate -%}
</div>
{% schema %}{ "name": "Collection" }{% endschema %}
