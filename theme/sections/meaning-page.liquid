{%- comment -%} Page « Le sens des bijoux » : uniquement des explications publiées par la boutique, reformulées fidèlement et sourcées. {%- endcomment -%}
<div class="wrap" style="padding-bottom:clamp(72px,9vw,140px)">
  <div class="chapters">
    {%- for block in section.blocks -%}
      {%- assign c = block.settings.collection -%}
      <article class="chapter" {{ block.shopify_attributes }}>
        <div class="chapter__aside">
          <p class="label label--rule" data-anim="fade">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</p>
          <h2 class="h2" data-anim="title" style="margin-top:14px">{{ block.settings.title }}</h2>
        </div>
        <div>
          <div class="prose" data-anim="title" data-anim-delay="0.1">{{ block.settings.text }}</div>
          {%- if block.settings.source_label != blank -%}
            <p class="source">Source : {% if block.settings.source_url != blank %}<a href="{{ block.settings.source_url }}">{{ block.settings.source_label }}</a>{% else %}{{ block.settings.source_label }}{% endif %}</p>
          {%- endif -%}
          {%- if c != blank -%}
            <div class="chapter__products">
              {%- for p in c.products limit: 4 -%}{% render 'product-card', product: p, delay: '0.1', sizes: '(min-width: 900px) 15vw, 45vw' %}{%- endfor -%}
            </div>
            <p style="margin-top:18px"><a class="link-arrow" href="{{ c.url }}">{{ 'general.view_all' | t }} {% render 'icon', name: 'arrow' %}</a></p>
          {%- endif -%}
        </div>
      </article>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Sens des bijoux",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "chapter",
      "name": "Chapitre",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "richtext", "id": "text", "label": "Texte (reprise fidèle d'une source officielle)" },
        { "type": "text", "id": "source_label", "label": "Source (libellé)" },
        { "type": "text", "id": "source_url", "label": "Source (lien)" },
        { "type": "collection", "id": "collection", "label": "Pièces concernées" }
      ]
    }
  ],
  "presets": [ { "name": "Sens des bijoux" } ]
}
{% endschema %}
