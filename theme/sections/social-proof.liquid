<section class="bg-section bg-section--tight"><div class="bg-wrap"><div class="bg-social" data-reveal>
  <div><p class="bg-kicker">{{ section.settings.kicker | escape }}</p><a class="bg-social__handle bg-chrome-text" href="{{ section.settings.url }}" rel="noopener">{{ section.settings.handle | escape }}</a>
    {%- if section.settings.text != blank -%}<p class="bg-dim" style="margin-top:18px">{{ section.settings.text | escape }}</p>{%- endif -%}</div>
  <div>
    {%- comment -%} Bloc « apparition » : ajouter UNIQUEMENT avec accord écrit et droits image ; ne jamais suggérer un partenariat non confirmé. {%- endcomment -%}
    {%- for b in section.blocks -%}{%- if b.settings.rights -%}<figure style="margin:0 0 20px" {{ b.shopify_attributes }}>{%- if b.settings.image -%}{{ b.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: b.settings.caption }}{%- endif -%}<figcaption class="bg-note">{{ b.settings.caption | escape }}</figcaption></figure>{%- endif -%}{%- endfor -%}
    <a class="bg-btn bg-btn--ghost" href="{{ section.settings.url }}" rel="noopener">{{ section.settings.cta | escape }}</a>
  </div>
</div></div></section>
{% schema %}
{ "name": "Communauté", "settings": [
  { "type": "text", "id": "kicker", "label": "Sur-titre", "default": "Communauté" },
  { "type": "text", "id": "handle", "label": "Compte", "default": "@breslev_gang" },
  { "type": "url", "id": "url", "label": "Lien du compte" },
  { "type": "text", "id": "text", "label": "Texte" },
  { "type": "text", "id": "cta", "label": "Bouton", "default": "Suivre la maison" } ],
  "blocks": [ { "type": "appearance", "name": "Apparition (droits confirmés)", "settings": [ { "type": "image_picker", "id": "image", "label": "Image (droits obtenus)" }, { "type": "text", "id": "caption", "label": "Légende factuelle" }, { "type": "checkbox", "id": "rights", "label": "J’atteste disposer de l’accord écrit et des droits image", "default": false } ] } ],
  "presets": [ { "name": "Communauté" } ] }
{% endschema %}
