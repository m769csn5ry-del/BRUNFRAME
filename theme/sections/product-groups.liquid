{%- assign total = section.blocks.size -%}
<section class="section" aria-label="{{ section.settings.heading | escape }}">
  <div class="wrap">
    {%- for block in section.blocks -%}
      {%- liquid
        assign c = block.settings.collection
        assign list = block.settings.products
        if list == blank or list.size == 0
          assign list = c.products
        endif
        assign title = block.settings.title | default: c.title
        assign link = block.settings.link | default: c.url
      -%}
      <div class="group" {{ block.shopify_attributes }}>
        <div class="sec-head">
          <div>
            <p class="label label--rule" data-anim="fade">{{ forloop.index | prepend: '0' | slice: -2, 2 }} / {{ total | prepend: '0' | slice: -2, 2 }}</p>
            <h2 class="h2" data-anim="title">{{ title }}</h2>
          </div>
          {%- if link != blank -%}<a class="link-arrow" href="{{ link }}" data-anim="fade">{%- if block.settings.link_label != blank -%}{{ block.settings.link_label }}{%- else -%}{{ 'general.view_all' | t }}{%- endif -%} {% render 'icon', name: 'arrow' %}</a>{%- endif -%}
        </div>
        <div class="grid">
          {%- for p in list limit: block.settings.count -%}
            {%- capture d -%}0.{{ forloop.index0 | modulo: 4 }}{%- endcapture -%}
            {% render 'product-card', product: p, delay: d %}
          {%- endfor -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Groupes de produits",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "heading", "label": "Nom de la section (accessibilité)", "default": "Sélection de pièces" }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Groupe",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre (sinon : nom de la collection)" },
        { "type": "collection", "id": "collection", "label": "Collection (lien « Voir toute la collection »)" },
        { "type": "url", "id": "link", "label": "Ou lien libre", "info": "Ex. tous les produits d'un type : /collections/types?q=Petek%20%C3%A0%20chaine" },
        { "type": "text", "id": "link_label", "label": "Libellé du lien", "default": "Voir toute la collection" },
        { "type": "product_list", "id": "products", "label": "Produits mis en avant", "limit": 12, "info": "Vide : les premiers produits de la collection." },
        { "type": "range", "id": "count", "label": "Nombre de produits", "min": 1, "max": 12, "step": 1, "default": 4 }
      ]
    }
  ],
  "presets": [ { "name": "Groupes de produits" } ]
}
{% endschema %}
