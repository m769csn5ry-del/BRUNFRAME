<section class="bg-section bg-section--tight" id="maison"><div class="bg-wrap bg-story">
  <div data-reveal>
    <p class="bg-kicker">{{ section.settings.kicker | escape }}</p>
    <p class="lead">{{ section.settings.lead | escape }}</p>
    {%- if section.settings.body != blank -%}<div class="bg-dim">{{ section.settings.body }}</div>{%- else -%}<div class="bg-placeholder">{{ 'story.placeholder' | t }}</div>{%- endif -%}
  </div>
  <div class="bg-tiles" style="grid-template-rows:none;grid-template-columns:1fr" data-reveal>
    <a class="bg-tile" href="{{ section.settings.link | default: routes.collections_url }}" style="min-height:min(110vw,620px)">
      {%- if section.settings.image -%}{{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600,900,1200', sizes: '(min-width: 900px) 50vw, 100vw', alt: section.settings.image.alt }}{%- endif -%}
      <div class="bg-tile__label"><p class="bg-display">{{ section.settings.image_label | escape }}</p></div>
    </a>
  </div>
</div></section>
{% schema %}
{ "name": "Histoire de la marque", "settings": [
  { "type": "text", "id": "kicker", "label": "Sur-titre", "default": "La maison" },
  { "type": "text", "id": "lead", "label": "Phrase d’accroche", "default": "Peteks, flammes, Maguen David, Hay : des pièces que l’on porte près du cœur." },
  { "type": "richtext", "id": "body", "label": "Texte authentique (validé par la marque)" },
  { "type": "image_picker", "id": "image", "label": "Image (photo réelle)" },
  { "type": "text", "id": "image_label", "label": "Libellé de l’image", "default": "Cuir, perles & parchemin" },
  { "type": "url", "id": "link", "label": "Lien de l’image" } ],
  "presets": [ { "name": "Histoire de la marque" } ] }
{% endschema %}
