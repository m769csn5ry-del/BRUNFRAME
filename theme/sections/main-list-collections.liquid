<div class="wrap page-head">
  <p class="label label--rule" data-anim="fade">{{ section.settings.label }}</p>
  <h1 class="h1" data-anim="title">{{ section.settings.heading }}</h1>
</div>
<div class="wrap" style="padding-bottom:clamp(72px,9vw,140px)">
  <div class="colls">
    {%- for c in collections -%}
      {%- if c.all_products_count == 0 or c.handle == 'all' -%}{%- continue -%}{%- endif -%}
      {%- assign im = c.image | default: c.products.first.featured_image -%}
      <a class="coll-tile" href="{{ c.url }}" data-anim="rise" data-anim-delay="0.{{ forloop.index0 | modulo: 3 }}">
        {%- if im != blank -%}<span class="ph-bg" style="background-image:url('{{ im | image_url: width: 40 }}')" aria-hidden="true"></span><img src="{{ im | image_url: width: 800 }}" srcset="{{ im | image_url: width: 480 }} 480w, {{ im | image_url: width: 800 }} 800w" sizes="(min-width: 900px) 33vw, (min-width: 550px) 50vw, 100vw" alt="" width="{{ im.width }}" height="{{ im.height }}" loading="lazy">{%- endif -%}
        <div><strong>{{ c.title }}</strong><span>{{ 'collections.results' | t: count: c.all_products_count }}</span></div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Toutes les collections",
  "settings": [
    { "type": "text", "id": "label", "label": "Sur-titre", "default": "Catalogue complet" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Toutes les collections" }
  ]
}
{% endschema %}
