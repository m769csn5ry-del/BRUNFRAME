    "meaning": {
      "type": "jewel-meaning",
      "settings": {
        "label": "Le sens des bijoux",
        "heading": "Chaque détail a un sens",
        "text": "Ce que la maison dit de ses symboles, sources à l'appui.",
        "link_label": "Lire le sens des bijoux",
        "link": "/pages/le-sens-des-bijoux"
      },
      "blocks": {
        "m1": {
          "type": "meaning",
          "settings": {
            "title": "La flamme",
            "text": "La flamme est le symbole emblématique de la maison. Elle exprime ses croyances essentielles, transmises par les paroles du Rabbi Nahman : « Mon feu brûlera jusqu'à la venue du Messie ».",
            "source_label": "Descriptions des colliers Flamme, breslevgang.com",
            "source_url": "https://breslevgang.com/collections/colliers-flamme-aesh-cheli-🔥",
            "link_label": "Voir les colliers Flamme",
            "link_url": "/collections/colliers-flamme-aesh-cheli-🔥"
          }
        },
        "m2": {
          "type": "meaning",
          "settings": {
            "title": "Le Petek",
            "text": "Le Petek renvoie à la lettre reçue en 1922 par Rabbi Israël Ber Odesser, que le récit attribue à Rabbi Nahman, et qui porte la formule « Na Na'h Na'hma Nahman Méouman ».",
            "source_label": "« L'histoire du Petek », journal de breslevgang.com",
            "source_url": "https://breslevgang.com/blogs/news/lhistoire-du-petek",
            "link_label": "Voir les Peteks",
            "link_url": "/collections/petek-perles"
          }
        },
        "m3": {
          "type": "meaning",
          "settings": {
            "title": "Breslev",
            "text": "Rabbi Na'hman de Breslev, né en 1772, est présenté par la maison comme le fondateur de la dynastie hassidique de Breslev.",
            "source_label": "« Breslev, c'est quoi ? », journal de breslevgang.com",
            "source_url": "https://breslevgang.com/blogs/news/breslev-cest-quoi",
            "link_label": "",
            "link_url": ""
          }
        }
      },
      "block_order": [
        "m1",
        "m2",
        "m3"
      ]
    },
